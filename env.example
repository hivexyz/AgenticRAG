# 环境配置 (development, production)
ENVIRONMENT=development

# 应用配置
APP_NAME=xiehe_institute
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS 配置（多个地址用逗号分隔）
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# PostgreSQL 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xiehe_institute
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# 向量存储后端配置（milvus / pgvector）
VECTOR_STORE_BACKEND=milvus

# Milvus 向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=vectors
MILVUS_DIMENSION=1536
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=L2

# pgvector 配置
PGVECTOR_TABLE_NAME=document_vectors
PGVECTOR_DISTANCE_METRIC=cosine
PGVECTOR_IVFFLAT_LISTS=100

# OpenAI API 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM 模型配置
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_TOP_P=1.0
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0

# Embedding 模型配置
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EMBEDDING_DIMENSION=1536

# Reranker 模型配置
OPENAI_RERANKER_MODEL=gpt-3.5-turbo
OPENAI_RERANKER_TOP_K=10
OPENAI_RERANKER_BASE_URL=

# AgenticRAG 配置
AGENTIC_RAG_MAX_RETRIEVALS=2
AGENTIC_RAG_QUALITY_THRESHOLD=0.8
AGENTIC_RAG_DEFAULT_TOP_K=10

# Gradio 界面配置
API_BASE_URL=http://localhost:8000
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
